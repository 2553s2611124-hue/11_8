    st.write("행사 시작 전 또는 현장 도착 직후 확인하세요.")

    tasks = [
        "가까운 비상구와 대피 경로를 확인했다.",
        "행사장 밖의 안전한 만남 장소를 정했다.",
        "안전요원 또는 안내데스크 위치를 확인했다.",
        "휴대전화 배터리와 긴급 연락 수단을 확인했다.",
        "일행과 헤어졌을 때 연락 방법을 정했다.",
        "출입구와 통로를 막지 않도록 주의한다.",
        "AED 등 응급 지원 위치를 확인했다.",
    ]

    if "checklist_state" not in st.session_state:
        st.session_state.checklist_state = [False] * len(tasks)

    with st.form("checklist_form"):
        checked = []

        for i, task in enumerate(tasks):
            value = st.checkbox(
                task,
                value=st.session_state.checklist_state[i],
                key=f"check_{i}",
            )
            checked.append(value)

        submitted = st.form_submit_button(
            "체크리스트 저장",
            use_container_width=True,
        )

    if submitted:
        st.session_state.checklist_state = checked
        completed = sum(checked)
        st.success(f"{completed} / {len(tasks)}개 항목 확인 완료")

    completed = sum(st.session_state.checklist_state)
    st.progress(completed / len(tasks))

    if completed == len(tasks):
        st.success("모든 항목을 확인했습니다.")
    else:
        st.caption(f"남은 항목: {len(tasks) - completed}개")

    st.info(
        "체크 상태는 현재 앱 세션에서만 유지됩니다. "
        "새 세션에서는 초기화될 수 있습니다."
    )

