                "폭력·위협",
                "기타",
            ],
        )

        status = st.selectbox(
            "피해 상황",
            [
                "아직 확인되지 않음",
                "부상자 없음으로 확인",
                "부상자 있음",
                "의식 저하 또는 호흡 이상",
                "다수의 피해자 발생",
            ],
        )

        details = st.text_area(
            "확인한 상황",
            placeholder="직접 확인한 사실을 간단히 입력하세요.",
            max_chars=1000,
        )

        submitted = st.form_submit_button(
            "사고 메모 만들기",
            use_container_width=True,
        )

    if submitted:
        if not location.strip():
            st.error("사고 장소를 입력해 주세요.")
        else:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            note = (
                "[행사장 사고 상황 메모]\n"
                f"작성 시각: {timestamp}\n"
                f"사고 장소: {location.strip()}\n"
                f"사고 유형: {incident_type}\n"
                f"피해 상황: {status}\n"
                f"상세 내용: {details.strip() or '추가 정보 없음'}\n"
            )

            st.success("메모를 만들었습니다.")
            st.code(note, language="text")

            st.download_button(
                "📥 TXT 파일 다운로드",
                data=note,
                file_name="incident_note.txt",
                mime="text/plain",
                use_container_width=True,
            )

            st.caption(
                "메모는 앱 데이터베이스에 저장하지 않습니다. "
                "개인정보나 민감한 정보는 최소한으로 기록하세요."
            )

